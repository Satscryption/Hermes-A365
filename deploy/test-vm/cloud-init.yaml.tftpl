#cloud-config
users: [{name: hermes, system: true, shell: /usr/sbin/nologin, homedir: /var/lib/hermes}]
write_files:
  - path: /etc/caddy/Caddyfile
    content: |
      { admin off }
      ${fqdn} {
        @messages path /api/messages
        handle @messages { reverse_proxy 127.0.0.1:3978 }
        handle { respond 404 }
      }
  - path: /etc/systemd/system/hermes-gateway.service
    content: |
      [Service]
      User=hermes
      Environment=HOME=/var/lib/hermes
      Environment=HERMES_HOME=/var/lib/hermes/.hermes
      ExecStart=/opt/hermes/venv/bin/hermes gateway run
      Restart=no
      NoNewPrivileges=true
      ProtectSystem=strict
      ProtectHome=true
      PrivateTmp=true
      ReadWritePaths=/var/lib/hermes
      CapabilityBoundingSet=
runcmd:
  - install -d -m 0700 -o hermes -g hermes /var/lib/hermes
  - bash -c 'apt-get update && apt-get install -y caddy git curl ca-certificates; echo net.ipv4.tcp_mtu_probing=1 >/etc/sysctl.d/99-hermes.conf; echo "precedence ::ffff:0:0/96  100" >>/etc/gai.conf; printf "%s\n" "Unattended-Upgrade::Automatic-Reboot \"false\";" >/etc/apt/apt.conf.d/51hermes-no-reboot; sysctl --system'
  - bash -c 'curl -LsSf https://astral.sh/uv/${uv_version}/install.sh | sh; install -d -m 0755 /opt/hermes; /root/.local/bin/uv venv /opt/hermes/venv --python 3.14; /root/.local/bin/uv pip install --python /opt/hermes/venv/bin/python "hermes-agent @ git+https://github.com/NousResearch/hermes-agent@${hermes_agent_ref}" "hermes-a365 @ git+https://github.com/Satscryption/Hermes-A365@${hermes_a365_ref}"'
  - systemctl enable --now caddy && systemctl restart caddy && systemctl daemon-reload